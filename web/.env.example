# Copy to .env for local runs. On Railway, set these as service Variables.
# Never commit .env — it can hold your private key.

VITE_NETWORK=mainnet

# The $EARN token (CA). Joins are checked against it.
VITE_TOKEN_ID=earn.v2-launchpad.justhoot.near

# Minimum $EARN (whole tokens) to join, until the gacha contract is live.
# 0 = any balance above zero. After that, the contract's min_hold is used.
MIN_HOLD=0

# Your gacha contract account (leave empty until it's deployed; joining
# still works and every batch is saved)
VITE_CONTRACT_ID=

# Batch length in minutes (default 30)
BATCH_MINUTES=30

# Where batch entries are saved (Railway: attach a volume at /data)
# DATA_DIR=/data

# Owner key — needed for `npm run draw`, or for AUTO_DRAW on the server
OWNER_ACCOUNT_ID=
OWNER_PRIVATE_KEY=

# true = the server pulls the gacha by itself when each batch closes
AUTO_DRAW=false

# For `npm run draw` on your computer: the live site URL (where entries live)
SITE_URL=
