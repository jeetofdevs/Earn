# Copy to .env for local runs. On Railway, set these as service Variables.
# Never commit .env — it can hold your private key.

# Your gacha contract account, e.g. gacha.yourtoken.near
VITE_NETWORK=mainnet
VITE_CONTRACT_ID=

# Batch length in minutes (default 30)
BATCH_MINUTES=30

# Where batch entries are saved (Railway: attach a volume at /data)
# DATA_DIR=/data

# Owner key — needed for `npm run draw`, or for AUTO_DRAW on the server
OWNER_ACCOUNT_ID=
OWNER_PRIVATE_KEY=

# true = the server pulls the gacha by itself when each batch closes
AUTO_DRAW=false

# For `npm run draw` on your computer: the live site URL (where entries live)
SITE_URL=
