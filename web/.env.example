# Copy to .env for local runs. On Railway, set these as service Variables.
# Never commit .env — it holds the fee wallet's private key.

VITE_NETWORK=mainnet
TOKEN_ID=earn.v2-launchpad.justhoot.near

# The wallet that receives the tax fees and pays holders
FEE_WALLET=
FEE_WALLET_PRIVATE_KEY=

# Pay holders automatically on a schedule
AUTO_DISTRIBUTE=true
DISTRIBUTE_HOURS=24

# Password for the hidden /owner page (preview + "Distribute now"); 8+ chars
ADMIN_PASSWORD=

# Never paid (comma separated): liquidity pools, the launchpad, exchanges, team wallets
EXCLUDE=

# Minimum $EARN (whole tokens) to earn a share; 0 = any balance
MIN_HOLD=0
# Payouts below this ($EARN) are skipped and stay for the next round
MIN_PAYOUT=0.01
# $EARN to always keep in the fee wallet
KEEP_IN_WALLET=0
# Most holders paid per round (largest first)
MAX_RECIPIENTS=5000

# Where payout history is saved (Railway: attach a volume at /data)
DATA_DIR=/data

# Optional: NearBlocks API key for big holder lists
NEARBLOCKS_API_KEY=
